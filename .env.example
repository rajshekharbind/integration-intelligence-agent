# OpenAI API configuration (for structured extraction & reasoning)
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Tavily API configuration (for automated search of official developer docs)
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Configuration
MAX_SEARCH_RESULTS=6
MAX_RETRIES=2
REQUEST_TIMEOUT=20
MOCK_FALLBACK_ON_AUTH_ERROR=true
